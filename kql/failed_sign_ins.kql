// Failed Windows logons in the last 7 days, grouped by account and computer.
// Run in Microsoft's free Log Analytics demo environment (https://aka.ms/LADemo).
// Event ID 4625 = "An account failed to log on".
SecurityEvent
| where TimeGenerated > ago(7d)
| where EventID == 4625
| summarize FailedAttempts = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by TargetAccount, Computer
| where FailedAttempts >= 5
| order by FailedAttempts desc
| take 20
